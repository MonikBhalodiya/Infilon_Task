<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net5.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Test_Taste_Console_Application</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="FileOutput\**" />
      <EmbeddedResource Remove="FileOutput\**" />
      <None Remove="FileOutput\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="FileOutput\" />
      <None Remove="Domain\Objects\" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="log4net" Version="3.4.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="5.0.2" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="5.0.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
      <None Update="log4net.config">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Domain\Objects\" />
    </ItemGroup>
</Project>
